# Rendered by install.sh (__PYTHON3__, __RUNTIME__) into ~/opt/agent-usage-tracker/;
# ~/.config/systemd/user/ holds a symlink to it. Linux counterpart of the
# LaunchAgent of the same name in ../launchd/.
[Unit]
Description=agent-usage-tracker: transcript reader

[Service]
Type=oneshot
ExecStart=__PYTHON3__ __RUNTIME__/src/transcript_reader.py
StandardOutput=append:__RUNTIME__/logs/transcript-reader.log
StandardError=append:__RUNTIME__/logs/transcript-reader.err
