# Rendered by install.sh (__PYTHON3__, __RUNTIME__) into ~/opt/agent-usage-tracker/;
# ~/.config/systemd/user/ holds a symlink to it. Linux counterpart of the
# LaunchAgent of the same name in ../launchd/.
[Unit]
Description=agent-usage-tracker: push new rows to the central store

[Service]
Type=oneshot
ExecStart=__PYTHON3__ __RUNTIME__/src/push_to_central.py
StandardOutput=append:__RUNTIME__/logs/push.log
StandardError=append:__RUNTIME__/logs/push.err
