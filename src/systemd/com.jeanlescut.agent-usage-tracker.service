# Rendered by install.sh (__PYTHON3__, __RUNTIME__) into ~/opt/agent-usage-tracker/;
# ~/.config/systemd/user/ holds a symlink to it. Linux counterpart of the
# LaunchAgent of the same name in ../launchd/.
[Unit]
Description=agent-usage-tracker: pollers (each self-throttles)

[Service]
Type=oneshot
ExecStart=__PYTHON3__ __RUNTIME__/src/run_pollers.py
StandardOutput=append:__RUNTIME__/logs/quota-poll.log
StandardError=append:__RUNTIME__/logs/quota-poll.err
