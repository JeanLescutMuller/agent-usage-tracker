<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeanlescut.agent-usage-tracker.transcripts</string>

    <!-- Every 5 minutes: store the API requests found in Claude Code's
         transcripts. Incremental (a byte offset per file), so a run with
         nothing new takes milliseconds. See transcript_reader.py's
         docstring. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON3__</string>
        <string>__RUNTIME__/src/transcript_reader.py</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__RUNTIME__/logs/transcript-reader.log</string>
    <key>StandardErrorPath</key>
    <string>__RUNTIME__/logs/transcript-reader.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
