<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeanlescut.agent-usage-tracker.push</string>

    <!-- Every 5 minutes: copy the new rows of every database to the central
         store on the VM (H-Frank-1), new rows only, over ssh. A run with
         nothing new takes milliseconds. See push_to_central.py's
         docstring. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON3__</string>
        <string>__RUNTIME__/src/push_to_central.py</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__RUNTIME__/logs/push.log</string>
    <key>StandardErrorPath</key>
    <string>__RUNTIME__/logs/push.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
